# ============================================================
# VELONTRI CHATBOT - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# ── Server Configuration ────────────────────────────────────
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ── OpenAI Configuration (Optional) ─────────────────────────
# Leave empty to use built-in conversation engine
# Add your key to enable GPT-4o powered conversations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Velontri Marketplace API ────────────────────────────────
VELONTRI_API_URL=https://velontri.onrender.com/api/v1
VELONTRI_TIMEOUT_MS=60000

# ── Session Configuration ───────────────────────────────────
SESSION_TTL_SECONDS=3600

# ── Supabase Database Configuration ─────────────────────────
# Get these from your Supabase project:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings → API
# 4. Copy the values below

# Project URL (looks like: https://xxxxx.supabase.co)
SUPABASE_URL=

# Service Role Key (click "Reveal" next to service_role)
# ⚠️ WARNING: Never expose this key publicly!
SUPABASE_SERVICE_KEY=

# ============================================================
# QUICK SETUP GUIDE
# ============================================================
#
# 1. CREATE SUPABASE PROJECT
#    - Go to https://supabase.com
#    - Click "New Project"
#    - Choose name, password, region (Lagos recommended)
#    - Wait 2-3 minutes
#
# 2. RUN DATABASE SCHEMA
#    - Open SQL Editor in Supabase
#    - Copy contents of backend/schema.sql
#    - Paste and click "Run"
#    - Verify tables exist in Table Editor
#
# 3. GET YOUR CREDENTIALS
#    - Settings → API in Supabase
#    - Copy Project URL → paste above
#    - Copy service_role key → paste above
#
# 4. TEST LOCALLY
#    - Save this file as .env
#    - Run: node server.js
#    - Should see no database errors!
#
# 5. DEPLOY TO PRODUCTION
#    - See DEPLOYMENT_CHECKLIST.md for full guide
#
# ============================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================
#
# When deploying to Render/Railway/Heroku:
#
# 1. Update FRONTEND_ORIGIN to your actual frontend URL:
#    FRONTEND_ORIGIN=https://your-app.vercel.app
#
# 2. Add all these variables to your hosting platform
#    (Don't commit .env to Git!)
#
# 3. For Render.com:
#    - Dashboard → Environment → Add each variable
#
# 4. For Railway:
#    - Click service → Variables → Add each variable
#
# 5. For Vercel (backend):
#    - Settings → Environment Variables → Add each
#
# ============================================================

# That's it! Need help? Check DEPLOYMENT_CHECKLIST.md
